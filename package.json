{
  "name": "sentence",
  "version": "1.0.0",
  "description": "Sentence: universal, offline-first AI bridge between cloud providers and local transformers.js models",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/pure.test.ts",
    "create-key": "tsx scripts/create-api-key.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "idb": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
