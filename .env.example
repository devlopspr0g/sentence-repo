PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32-byte key, hex encoded (64 hex chars), used to decrypt providers.api_key_encrypted (AES-256-GCM)
PROVIDER_ENCRYPTION_KEY=
# Optional env-level provider keys (used when no DB provider row exists)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
# Primary cloud model used by model "auto" before falling back to local
AUTO_PRIMARY_MODEL=gpt-4o-mini
LOCAL_MODEL_CACHE_DIR=./.cache/models

# --- Shared memory ("center brain") ---
# true  = a user's request may fall back to the keys above when they have not added their own
# false = every user must bring their own keys (POST /v1/keys); recommended when hosting for others
ALLOW_SERVER_KEYS=true
# Model that writes rolling topic summaries: "auto", a model id, or a local-* model
SUMMARY_MODEL=auto
SUMMARY_EVERY_MESSAGES=6
# Max characters of memory injected into a request, and how far back "continue"-style follow-ups look
WHISPER_MAX_CHARS=4000
WHISPER_TIMELINE_HOURS=48
# Load the embedding model at startup instead of on first request
PRELOAD_EMBEDDINGS=false
